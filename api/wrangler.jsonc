{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "daprova",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Postgres (Neon) via Hyperdrive. Create it once with
  //   npx wrangler hyperdrive create daprova-db --connection-string="<neon direct URL>"
  // and paste the id it prints here. "localConnectionString" is what
  // `wrangler dev` uses instead.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "ae45804478a24181bdddeaea5bb2bb7d",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/daprova_dev"
    }
  ],

  // Every minute: payment reconciliation. Hourly (:07): the billing job.
  // worker.ts tells them apart by controller.cron; index.ts uses setIntervals on Node.
  "triggers": { "crons": ["* * * * *", "7 * * * *"] },

  // See src/worker/fsShim.ts — pdfkit's data files, served from the bundle.
  "alias": { "fs": "./src/worker/fsShim.ts" },
  "rules": [{ "type": "Data", "globs": ["**/*.afm", "**/*.trie"], "fallthrough": true }],
  "define": { "__dirname": "\"/bundle\"" },

  "observability": { "enabled": true },

  // Non-secret config. Secrets (SESSION_JWT_SECRET, REFRESH_JWT_SECRET,
  // FIREBASE_API_KEY, RESEND_API_KEY, BOOTSTRAP_SECRET) are set with
  // `npx wrangler secret put <NAME>`, never here.
  "vars": {
    "NODE_ENV": "production",
    "FIREBASE_PROJECT_ID": "daprova-a5edb",
    "INVITE_FROM_EMAIL": "onboarding@daprova.com",
    "COOKIE_SAMESITE": "none",
    "ADMIN_DASHBOARD_ORIGIN": "https://daprova-admin.pages.dev",
    "ASSESSMENT_WEB_ORIGIN": "https://daprova-assess.pages.dev",
    "PLATFORM_WEB_ORIGIN": "https://daprova-platform.pages.dev",
    // This API's own address, for links that leave the app (org logos in emails).
    "API_PUBLIC_URL": "https://daprova.onyewuchiscepter.workers.dev"
  }
}
